# Safe to expose to the browser. Use the values from this Supabase project only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. A Supabase sb_secret_ key or legacy service_role key is accepted.
# Never add NEXT_PUBLIC_ to this name, commit the value, or paste it into chat/logs.
SUPABASE_SERVICE_ROLE_KEY=your-server-secret-key

# Server-only Spotify application credentials.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
